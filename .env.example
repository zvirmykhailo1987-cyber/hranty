# Copy to .env to override defaults. Never commit a real .env.
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
HRANTY_ENV=demo                # dev | demo | production
HRANTY_SECRET=
# Production only (empty database): password of the first admin, 12+ characters.
HRANTY_BOOTSTRAP_PASSWORD=
# Set to 1 behind HTTPS in non-production environments to mark cookies Secure.
HRANTY_SECURE_COOKIES=0
# Bearer token of the ingest worker for POST /api/ingest/radar (empty disables the API).
HRANTY_API_TOKEN=
